{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overture-road-route-search",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 公開範囲: workers.dev の前に Cloudflare Access（shiwaku@mierune.co.jp だけ通す）。設定はダッシュボード側で、ここには出てこない
  // （README「アクセス制限」）。ログインしていない人のリクエストは Worker まで来ないので、コンテナも起きない
  "workers_dev": true,
  "preview_urls": false,

  // 画面（SvelteKit の adapter-static 出力）。/api と /tiles だけ Worker のコードを通し、他は Assets が直接返す。
  // 道路タイル（3.7 GB）は web/static/.assetsignore で外し、R2 から返す
  "assets": {
    "directory": "../../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tiles/*"]
  },

  // 道路タイルは共有バケット shi-works の pmtiles/overture-road-route-search/ に置く（キーは src/worker.ts の TILE_KEY）
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "shi-works" }],

  // 重い探索（/reachability /route）の回数を絞る（KSJ 版と同じ値）。1 人 10 秒 20 回・1 IP 10 秒 300 回。
  // 大まかにしか効かないので、落ちない保証はコンテナ側の同時計算 2 本（api/core.py）で持つ
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 10 } },
    { "name": "IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 10 } }
  ],

  // イメージは push 済みのもの（registry.cloudflare.com）を指す。Dockerfile を指すと deploy のたびに 3 つ（計 13 GB）を
  // ビルドして push し直し、1 時間を超えてログインのトークンが切れることがある（2026-11-01）。
  // イメージを作り直すときは README「イメージの更新」の手順で push してから、ここのタグを書き換える。
  // 大陸（つながっている道路網）ごとに 1 台（issue #9 の A 案）。常駐メモリは手元の実測（scripts/17_measure_shard.py、2026-11-01）。
  // 使うときだけ起きて SLEEP_AFTER で寝るので、課金は起きている間だけ
  "containers": [
    {
      // 常駐 9.6 GiB・グラフ 8.9 GiB → 4 vCPU・12 GiB・20 GB disk
      "class_name": "EurasiaContainer",
      "image": "registry.cloudflare.com/993e6751b27bc08e37b6b6e0e601587b/overture-road-route-search-eurasiacontainer:f3bb31e5",
      "instance_type": "standard-4",
      "max_instances": 1
    },
    {
      // 常駐 5.1 GiB・グラフ 4.5 GiB。standard-2（6 GiB）は余裕が 0.9 GiB しかないので 1 つ上
      "class_name": "AmericasContainer",
      "image": "registry.cloudflare.com/993e6751b27bc08e37b6b6e0e601587b/overture-road-route-search-americascontainer:f3bb31e5",
      "instance_type": "standard-3",
      "max_instances": 1
    },
    {
      // 常駐 2.3 GiB・グラフ 2.0 GiB → 1/2 vCPU・4 GiB
      "class_name": "OtherContainer",
      "image": "registry.cloudflare.com/993e6751b27bc08e37b6b6e0e601587b/overture-road-route-search-othercontainer:f3bb31e5",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "vars": {
    "SLEEP_AFTER": "10m"
  },
  "durable_objects": {
    "bindings": [
      { "name": "EURASIA", "class_name": "EurasiaContainer" },
      { "name": "AMERICAS", "class_name": "AmericasContainer" },
      { "name": "OTHER", "class_name": "OtherContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EurasiaContainer", "AmericasContainer", "OtherContainer"] }]
}
